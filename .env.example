# 复制为 .env 后按需填写。不填也能跑：默认 oss 档、腾讯源、固定源检索、无 Key 自动退规则。
# 服务入口（main.py）与 jobs/build_cases CLI 在导入期自动加载本文件；改完重启服务生效。
# 优先级：真实环境变量（set / 系统变量）> .env 文件；文件不会覆盖已有值。
# 离线工具（tools/verify_*.py 等）不加载 .env，需要时设变量或用 uvicorn --env-file .env。
# 注意：.env 已在 .gitignore 中排除，永远不会入库。

# ---- 运行档位（默认 oss，安全优先；本地私有环境设 private）----
# APP_PROFILE=oss              # oss | private
# DATA_SOURCE=tencent          # tencent | tushare（阶段 2 起扩展 akshare / baostock）
# PRODUCER=llm_direct          # llm_direct（无 Key 自动退规则）| rule | agent | manual
# SEARCH_PROVIDER=none         # 已实现 none | search_api；searxng / agent / llm_builtin 预留未实现

# ---- 数据目录（阶段 6：夹具与真实数据分家）----
# 不设 = 用 backend/data 里的冻结夹具，8100/8101 的差分基线不受影响；
# 设了 = 服务与所有 CLI 子任务统一改用该目录，可让一个实例自己抓数、自己长数据。
# 例：ASTOCK_DATA_DIR=D:/code/astock-v2/backend/data-live
# ASTOCK_DATA_DIR=

# ---- 存储层（阶段 3：默认内置 SQLite，零新增依赖）----
# STORAGE_BACKEND=sqlite       # sqlite | mysql | postgres（后两者只留接口，未实现，选中会明确报错）
# DB_DSN=                      # MySQL/PG 的连接串；sqlite 档留空
# ASTOCK_DB_PATH=              # 默认 backend/data/astock.db；设 :memory: 完全不落盘（验证用）
# ASTOCK_OWNER=default         # 多用户预留，单用户不用改
# STORAGE_READ=files           # files（默认，零侵入）| db（8 张资产表读走 SQLite）
# STORAGE_BOOTSTRAP=auto       # db 档且库为空时从 backend/data 自举；off = 不自举
# STORAGE_STRICT=0             # 1 = db 档初始化失败直接抛错，不回退 files
# STORAGE_DUAL_WRITE=0         # 保留字段；db 档下写后自动整表同步，无需开双写
# DB_JOURNAL=wal               # wal | memory（只读/受限环境用 memory）

# ---- AI 摘要（可选，OpenAI 兼容接口）----
# 注意：ai.config() 的实际优先级是「data/.secrets/llm.json 文件 > 环境变量」；
# 若该文件存在并含 api_key，它会盖掉这里的 LLM_API_KEY。要只用 .env 就别放该文件。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 资讯事实层检索（可选，默认 none：只抓固定源，不需要任何 Key）----
# SEARCH_API_BACKEND=tavily    # tavily | serper | generic
# SEARCH_API_KEY=              # 也可放 backend/data/.secrets/search.json
# SEARCH_API_MAX_QUERIES=4
# SEARCH_API_MAX_RESULTS=5
# SEARCH_MAX_QUERIES=3
# generic 档：SEARCH_API_URL（{query} 占位）、SEARCH_API_RESULTS_PATH、SEARCH_API_FIELDS

# ---- 内置调度（阶段 4；默认关闭，影子期不注册新路由）----
# SCHEDULER_ENABLED=1         # 只有设为 1 才挂载 /api/jobs/* 并在 startup 启动
# SCHEDULER_BACKEND=auto      # auto | apscheduler | builtin（auto：装了 APScheduler 就用，否则标准库）
# SCHEDULER_DRY_RUN=1         # 默认开：只记录 job_runs，不抓行情不写业务数据；确认无误后设 0
# SCHEDULER_CATCHUP=1         # 启动时按最近交易日补跑缺跑的固定任务
# SCHEDULER_TRADING_DAYS_ONLY=1  # 非交易日跳过（追补按最近交易日，不受当天影响）
# SCHEDULER_MISFIRE=7200      # 触发延迟超过该秒数则不补跑（coalesce 语义）
# EOD_CRON=0 16 * * 1-5       # 覆盖盘后 EOD 的 cron
# ASTOCK_CALENDAR=            # 可选，指向 holidays.json（见 examples/trading_calendar.example.json）
# 可选成熟后端：pip install -r requirements-scheduler.txt
# 手工触发：  curl -X POST http://127.0.0.1:8100/api/jobs/eod_close/run

# ---- 服务监听（默认只绑本机，不要改成 0.0.0.0 直接暴露公网）----
HOST=127.0.0.1
PORT=8100

# ---- 阶段 5：契约 / producers（除第一条外均在仓库根目录执行）----
# 盘后批处理预演： cd backend && python -m jobs.build_cases --date 2026-11-10 --producer rule --limit 10 --json
#   （加 --apply 才写 pregen 文件，默认 dry-run 不落盘）
# 契约验收：       python tools\verify_producers.py --json
# 旧资讯格式预演： python tools\normalize_news.py --src backend\data\news --json
# 导出 schema：     python tools\export_schemas.py ai_brief > docs\contracts\ai_brief.schema.json

# ---- 运维监控 + Key 自助配置（不新增 GET 路由）----
# 监控页：http://127.0.0.1:8100/static/ops.html
#   服务健康 / 运行档位 / Key 已配未配（不显示值）/ 定时任务 / 最近运行
# 配置页：http://127.0.0.1:8000/static/config.html  （或监控页点「配置 Key」）
#   选服务商 → 粘贴密钥 → 保存即时生效，无需改文件、无需重启；只回显掩码
# CONFIG_API_ENABLED=1       # 0 = 关闭配置能力（只留只读监控页）
# PREGEN_ON_EOD=1            # EOD 真实执行后自动生成 digest + pregen（接线用）
# 配置快照按实例端口隔离，由服务启动期写入 frontend/ops-config.<端口>.json
#   （脱敏、已 gitignore）；自检临时进程设 ASTOCK_OPS_SNAPSHOT=0 完全不写。
#
# ---- 常用命令（在 backend/ 目录下执行）----
# 启动服务：     python -m uvicorn main:app --host 127.0.0.1 --port 8000
# 安装自检：     python ..\tools\verify.py --offline
# 配置验收：     python ..\tools\verify_config.py   （临时目录，不碰真实密钥）
# 资讯预演：     python -m jobs.fetch_news --dry-run --apply
#
# ---- 存储层（在仓库根目录执行；源目录只读）----
# 预演：         python tools\importer.py --src backend\data --db :memory: --dry-run
# 导入+校验：    python tools\importer.py --src <数据目录> --db :memory: --json
# 只导 7 张核心：python tools\importer.py --src <数据目录> --core-only --db :memory:
# 逐函数对账：   python tools\verify_storage.py --src <数据目录> --db :memory:
# 读路径验收：   python tools\verify_read_switch.py --src backend\data --json
#
# ---- 切读路径启动（内存库不落盘，仅验证用）----
# set STORAGE_READ=db & set ASTOCK_DB_PATH=:memory: & python -m uvicorn main:app --host 127.0.0.1 --port 8000
# 归档旧库：     python tools\importer.py --rollback  （移到 data\db_backup\，不删除）
